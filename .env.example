# Supabase (hosted project)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Directus (self-hosted, MySQL-backed) — target backend of the in-progress
# migration on the directus-migration branch. Server-side use only.
DIRECTUS_URL=
DIRECTUS_API_TOKEN=

# Outgoing mail — defaults target the local Mailpit container (docker compose up -d)
# Moving these onto the company SMTP server is part of the Directus migration.
# NOTE: the transport reads MAIL_* only. Do not add EMAIL_* keys — nothing reads them.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Ember & Oak <hello@emberandoak.test>"
